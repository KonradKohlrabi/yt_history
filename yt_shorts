def sanitize_filename(name: str) -> str:
    return re.sub(r'[\\/*?:"<>|]', '', name).strip()


def get_duration(path):
    result = subprocess.run(
        ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", path],
        capture_output=True, text=True, check=True
    )
    return float(json.loads(result.stdout)["format"]["duration"])


def build_atempo_filter(speed):
    filters = []
    while speed > 2.0:
        filters.append("atempo=2.0")
        speed /= 2.0
    while speed < 0.5:
        filters.append("atempo=0.5")
        speed *= 2.0
    filters.append(f"atempo={speed:.6f}")
    return ",".join(filters)


def format_timestamp_ass(seconds):
    h  = int(seconds // 3600)
    m  = int((seconds % 3600) // 60)
    s  = int(seconds % 60)
    cs = int((seconds % 1) * 100)
    return f"{h}:{m:02}:{s:02}.{cs:02}"


def chunk_by_chars(words, max_chars):
    chunks, current, current_len = [], [], 0
    for word in words:
        w = word.word.strip()
        added_len = len(w) if not current else len(w) + 1
        if current and current_len + added_len > max_chars:
            chunks.append(current)
            current = [word]
            current_len = len(w)
        else:
            current.append(word)
            current_len += added_len
    if current:
        chunks.append(current)
    return chunks


def clean_caption_word(w):
    return w.strip().replace(".", "").replace(",", "").upper()


def build_ass_line(chunk, highlight_idx, highlight_color):
    words = [clean_caption_word(w.word) for w in chunk]
    parts = []
    for i, word in enumerate(words):
        if i == highlight_idx:
            parts.append(
                f"{{\\c{highlight_color}\\3c{highlight_color}\\3a&H60&\\bord{GLOW_BORD}}}"
                f"{word}"
                f"{{\\c{COLOR_PRIMARY}\\3c{COLOR_OUTLINE}\\3a&H00&\\bord{OUTLINE_WIDTH}}}"
            )
        else:
            parts.append(word)
    return " ".join(parts)


