async def phase7_tts(reformulated):
    phase(7, "Text-to-Speech & Speed Matching")

    print(f"  Running Edge TTS with voice '{VOICE}'...")
    await generate_tts_audio(reformulated)
    print(f"  TTS audio saved: {TMP_AUDIO_TTS}")

    video_dur = get_duration(TMP_INPAINTED_AUDIO)
    audio_dur = get_duration(TMP_AUDIO_TTS)
    factor    = audio_dur / video_dur

    print(f"  Video duration: {video_dur:.2f}s")
    print(f"  TTS duration:   {audio_dur:.2f}s")
    print(f"  Speed factor:   {factor:.3f}")

    subprocess.run([
        "ffmpeg", "-y", "-i", TMP_AUDIO_TTS,
        "-filter:a", build_atempo_filter(factor),
        TMP_AUDIO_SPEED
    ], check=True, capture_output=True)
    print(f"  Speed-adjusted audio saved: {TMP_AUDIO_SPEED}")

    print("  Merging TTS audio into video...")
    subprocess.run([
        "ffmpeg", "-y",
        "-i", TMP_INPAINTED_AUDIO,
        "-i", TMP_AUDIO_SPEED,
        "-c:v", "copy",
        "-map", "0:v:0", "-map", "1:a:0",
        "-shortest",
        TMP_FINAL_TTS_VIDEO
    ], check=True, capture_output=True)
    print(f"  Video with new audio: {TMP_FINAL_TTS_VIDEO}")


def phase8_captions(margin_vertical):
    phase(8, "Caption Generation")

    print(f"  Loading faster-whisper model '{WHISPER_MODEL_SIZE}'...")
    fw_model = WhisperModel(WHISPER_MODEL_SIZE, device="cpu", compute_type="int8")

    print("  Transcribing for captions (word timestamps)...")
    fw_segments, fw_info = fw_model.transcribe(
        TMP_FINAL_TTS_VIDEO, language=CAPTION_LANGUAGE, word_timestamps=True
    )
    print(f"  Detected language: {fw_info.language}")

    all_caption_words = []
    for seg in fw_segments:
        if seg.words:
            all_caption_words.extend(seg.words)

    caption_chunks = chunk_by_chars(all_caption_words, MAX_CAPTION_CHARS)
    print(f"  Caption chunks: {len(caption_chunks)}")

    ass_header = f"""[Script Info]
ScriptType: v4.00+
PlayResX: 1080
PlayResY: 1920

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Default,{FONT_NAME},{FONT_SIZE},{COLOR_PRIMARY},{COLOR_OUTLINE},&H00000000,1,0,0,0,100,100,0,0,1,{OUTLINE_WIDTH},{SHADOW_WIDTH},{ALIGNMENT},10,10,{margin_vertical},1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
"""

    with open(TMP_ASS, "w", encoding="utf-8") as f:
        f.write(ass_header)
        for chunk in caption_chunks:
            start           = format_timestamp_ass(chunk[0].start)
            end             = format_timestamp_ass(chunk[-1].end)
            highlight_idx   = random.randint(0, len(chunk) - 1)
            highlight_color = random.choice(HIGHLIGHT_COLORS)
            text            = build_ass_line(chunk, highlight_idx, highlight_color)
            f.write(f"Dialogue: 0,{start},{end},Default,,0,0,0,,{text}\n")

    print(f"  ASS saved: {TMP_ASS}")

    print("  Burning captions...")
    ass_escaped = str(Path(TMP_ASS).resolve()).replace("\\", "/").replace(":", "\\:")
    burn_result = subprocess.run([
        "ffmpeg", "-y",
        "-i", TMP_FINAL_TTS_VIDEO,
        "-vf", f"ass='{ass_escaped}'",
        "-c:a", "copy",
        TMP_CAPTIONED
    ], capture_output=True, text=True)

    if burn_result.returncode != 0:
        print("ffmpeg error:\n", burn_result.stderr)
        sys.exit(1)
    print(f"  Captioned video: {TMP_CAPTIONED}")


def phase9_music(final_output):
    phase(9, "Background Music")

    audio_files = [
        os.path.join(AUDIO_FOLDER, f)
        for f in os.listdir(AUDIO_FOLDER)
        if f.lower().endswith((".mp3", ".wav", ".ogg", ".m4a"))
    ] if os.path.isdir(AUDIO_FOLDER) else []

    if not audio_files:
        print("  No audio folder or files found — skipping background music.")
        import shutil
        shutil.copy(TMP_CAPTIONED, final_output)
        return

    music_path = random.choice(audio_files)
    print(f"  Selected track: {os.path.basename(music_path)}")

    mv_video = VideoFileClip(TMP_CAPTIONED)
    mv_music = AudioFileClip(music_path)

    if mv_music.duration < mv_video.duration:
        mv_music = mv_music.with_effects([afx.AudioLoop(duration=mv_video.duration)])
    else:
        mv_music = mv_music.subclipped(0, mv_video.duration)

    mv_music    = mv_music.with_volume_scaled(MUSIC_VOLUME)
    voice_audio = mv_video.audio.with_volume_scaled(VOICE_VOLUME) if mv_video.audio else None
    final_audio = CompositeAudioClip([voice_audio, mv_music]) if voice_audio else mv_music
    mv_video    = mv_video.with_audio(final_audio)

    print(f"  Writing final video: {final_output}")
    mv_video.write_videofile("videos/"+final_output, codec="libx264", audio_codec="aac")
    mv_video.close()
    mv_music.close()
    print(f"  Done: {final_output}")


def phase10_cleanup(margin_vertical, final_output, start_time, extra_file=None, video_key=None, video_title=None, description=None):
    phase(10, "Cleanup")
    print(f"  Margin Vertical: {margin_vertical}")
    print(f"  Total execution time: {time.perf_counter() - start_time:.2f}s")
    cleanup(extra_file)
    write_video_information_to_json(video_key, video_title, description)
    print(f"\n{'═'*55}")
    print(f"  PIPELINE COMPLETE")
    print(f"  Output: {final_output}")
    print(f"{'═'*55}\n")


async def process_single(input_path, start_time, video_key, extra_file=None):
    input_path = phase2_downscale(input_path)
    binary_mask, vid_fps, vid_width, vid_height, vid_total, margin_vertical = phase3_ocr_mask(input_path)
    phase4_inpainting(input_path, binary_mask, vid_fps, vid_width, vid_height, vid_total)
    whisper_result = phase5_transcribe()
    reformulated, video_title, description = phase6_reformulate(whisper_result)
    final_output = f"videos/{sanitize_filename(video_title)}.mp4"
    await phase7_tts(reformulated)
    phase8_captions(margin_vertical)
    phase9_music(video_key+".mp4")
    phase10_cleanup(margin_vertical, final_output, start_time, extra_file, video_key, video_title, description)
    return final_output


async def process_with_retries(video_key, input_path, start_time, extra_file=None):
    for attempt in range(1, MAX_VIDEO_RETRIES + 1):
        try:
            await process_single(input_path, start_time, video_key, extra_file=extra_file)
            return True
        except Exception as e:
            print(f"\n  Video '{video_key}' failed (attempt {attempt}/{MAX_VIDEO_RETRIES}): {e}")
    print(f"\n  Video '{video_key}' failed {MAX_VIDEO_RETRIES} times — skipping.")
    return False


async def run_pipeline():
    start_time = time.perf_counter()

    result, links_path = phase1_get_input()

    if isinstance(result, list):
        for video_key, input_path in result:
            print(f"\n{'━'*55}")
            print(f"  Processing: {video_key}")
            print(f"{'━'*55}")
            success = await process_with_retries(video_key, input_path, start_time, extra_file=input_path)
            if success and links_path:
                edit_json(links_path, video_key)
    else:
        await process_with_retries("input", result, start_time)


if __name__ == "__main__":
    asyncio.run(run_pipeline())