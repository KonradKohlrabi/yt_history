def phase2_downscale(input_path):
    phase(2, "Downscale to 1080x1920 (if needed)")

    probe = subprocess.run(
        ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_streams", input_path],
        capture_output=True, text=True, check=True
    )
    streams = json.loads(probe.stdout).get("streams", [])
    vid_stream = next((s for s in streams if s.get("codec_type") == "video"), None)

    if vid_stream is None:
        print("  Could not read video stream info — skipping downscale.")
        return input_path

    src_w = int(vid_stream.get("width", 0))
    src_h = int(vid_stream.get("height", 0))
    print(f"  Source resolution: {src_w}x{src_h}")

    if src_w <= 1080 and src_h <= 1920:
        print("  Resolution is within limits — no downscale needed.")
        return input_path

    print(f"  Downscaling to 1080x1920...")
    subprocess.run([
        "ffmpeg", "-y", "-i", input_path,
        "-vf", "scale=1080:1920:force_original_aspect_ratio=decrease,pad=1080:1920:(ow-iw)/2:(oh-ih)/2",
        "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "medium",
        "-c:a", "copy",
        TMP_DOWNSCALED
    ], check=True, capture_output=True)
    print(f"  Downscaled video saved: {TMP_DOWNSCALED}")
    return TMP_DOWNSCALED


def phase3_ocr_mask(input_path):
    phase(3, "OCR & Text Mask")

    print("  Loading EasyOCR...")
    ocr_reader = easyocr.Reader(OCR_LANGUAGES)

    cap = cv2.VideoCapture(input_path)
    if not cap.isOpened():
        print(f"Error: Could not open '{input_path}'")
        sys.exit(1)

    ret, frame = cap.read()
    if not ret:
        print("Error: Could not read first frame")
        sys.exit(1)

    vid_height, vid_width = frame.shape[:2]
    vid_fps     = cap.get(cv2.CAP_PROP_FPS) or 30
    vid_total   = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
    sample_step = max(1, int(vid_total / 25))

    print(f"  Video: {vid_width}x{vid_height}, {vid_fps:.1f} FPS, {vid_total} frames")
    print(f"  Sampling every {sample_step} frames (~25 samples total)")

    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
    vote_mask      = np.zeros((vid_height, vid_width), dtype=np.float32)
    frame_index    = 0
    sampled_frames = 0

    while True:
        ret, frame = cap.read()
        if not ret:
            break
        if frame_index % sample_step == 0:
            results = ocr_reader.readtext(frame)
            sampled_frames += 1
            for (bbox, text, conf) in results:
                if conf < CONF_THRESHOLD:
                    continue
                (tl, tr, br, bl) = bbox
                x_min = max(0,          int(min(tl[0], bl[0])) - PADDING)
                x_max = min(vid_width,  int(max(tr[0], br[0])) + PADDING)
                y_min = max(0,          int(min(tl[1], tr[1])) - PADDING)
                y_max = min(vid_height, int(max(bl[1], br[1])) + PADDING)
                vote_mask[y_min:y_max, x_min:x_max] += 1.0
            pct = frame_index / vid_total * 100
            print(f"  [{pct:5.1f}%] Frame {frame_index} – {len(results)} regions", end="\r")
        frame_index += 1

    cap.release()
    print(f"\n  {sampled_frames} frames analyzed.")

    norm_mask   = vote_mask / vote_mask.max() if vote_mask.max() > 0 else vote_mask
    binary_mask = (norm_mask > VOTE_THRESHOLD).astype(np.uint8)
    kernel      = np.ones((1, int(vid_width / DILATION_SIZE)), np.uint8)
    binary_mask = cv2.dilate(binary_mask, kernel, iterations=2)

    cv2.imwrite(TMP_MASK_IMG, binary_mask * 255)
    white_px = np.sum(binary_mask == 1)
    print(f"  Text regions: {white_px} px ({white_px / (vid_height * vid_width) * 100:.1f}%)")

    h, w = binary_mask.shape
    sub_mask = binary_mask[h // 3:, :]
    rows_with_text = np.where(sub_mask.max(axis=1) == 1)[0]
    if len(rows_with_text) > 0:
        first_text_y = (h // 3) + rows_with_text[0]
    else:
        first_text_y = None
    margin_vertical = h - first_text_y - 160 if first_text_y is not None else 425
    print(f"  Margin vertical: {margin_vertical}")

    return binary_mask, vid_fps, vid_width, vid_height, vid_total, margin_vertical


def phase4_inpainting(input_path, binary_mask, vid_fps, vid_width, vid_height, vid_total):
    phase(4, "Inpainting (remove original captions)")

    cap = cv2.VideoCapture(input_path)

    ffmpeg_inpaint = [
        "ffmpeg", "-y",
        "-f", "rawvideo", "-vcodec", "rawvideo",
        "-pix_fmt", "bgr24", "-s", f"{vid_width}x{vid_height}",
        "-r", str(vid_fps), "-i", "-",
        "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "medium",
        TMP_INPAINTED
    ]

    proc = subprocess.Popen(ffmpeg_inpaint, stdin=subprocess.PIPE)
    frame_index = 0

    while True:
        ret, frame = cap.read()
        if not ret:
            break
        result_frame = cv2.inpaint(frame, binary_mask, INPAINT_RADIUS, cv2.INPAINT_TELEA)
        proc.stdin.write(result_frame.tobytes())
        print(f"  [{frame_index / vid_total * 100:5.1f}%] Frame {frame_index}/{vid_total}", end="\r")
        frame_index += 1

    cap.release()
    proc.stdin.close()
    proc.wait()
    print(f"\n  Inpainting done.")

    print("  Re-attaching original audio...")
    subprocess.run([
        "ffmpeg", "-y",
        "-i", TMP_INPAINTED,
        "-i", input_path,
        "-c:v", "copy", "-c:a", "aac",
        "-map", "0:v:0", "-map", "1:a:0",
        TMP_INPAINTED_AUDIO
    ], check=True, capture_output=True)
    print(f"  Saved: {TMP_INPAINTED_AUDIO}")


